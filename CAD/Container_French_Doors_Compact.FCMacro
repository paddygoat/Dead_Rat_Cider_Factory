HASH_1 = '76b641ebb54c4eb1fe9b58aba7a9e37997e7e32b78d00ffb4bbc4586c1fa0740'

def orient_and_style_container(doc):
    # Rotate the assembly once, preserving every component's relative placement.
    # Original +Z (door exterior) -> -Y (FreeCAD front).
    # Original +Y (roof) -> +Z; handles at negative Y become lower in Z.
    roots = [o for o in doc.Objects
             if hasattr(o, 'Placement') and not o.InList
             and (o.TypeId == 'App::Part' or hasattr(o, 'Shape'))]
    if not roots:
        raise RuntimeError('No container assembly found to rotate.')
    rotation = App.Placement(App.Vector(0, 0, 0),
                             App.Rotation(App.Vector(1, 0, 0), 90))
    for root in roots:
        root.Placement = rotation.multiply(root.Placement)
    if App.GuiUp:
        for obj in doc.Objects:
            view = obj.ViewObject
            if hasattr(obj, 'Shape') and hasattr(view, 'DiffuseColor'):
                view.ShapeColor = (0.5, 0.5, 0.5)
                view.DiffuseColor = [(0.5, 0.5, 0.5)]
                view.Transparency = 50
                view.LineColor = (0.25, 0.25, 0.25)
    doc.Label = '20ft Container - Front Doors - Grey 50%'
    doc.recompute()
    if App.GuiUp:
        import FreeCADGui as Gui
    return doc

def customize_doors(doc):
    import Part
    removed = [o for o in doc.Objects if 'glazing horizontal muntin' in o.Label.lower()]
    for obj in removed:
        doc.removeObject(obj.Name)
    panes = [o for o in doc.Objects if 'glazed leaf inset' in o.Label.lower()]
    if len(panes) != 2:
        raise RuntimeError('Expected two glass panels; found %d.' % len(panes))
    for obj in doc.Objects:
        if obj.Name in container_object_names:
            continue
        if App.GuiUp and hasattr(obj, 'Shape') and hasattr(obj.ViewObject, 'DiffuseColor'):
            view = obj.ViewObject
            view.ShapeColor = (0.5, 0.5, 0.5)
            view.DiffuseColor = [(0.5, 0.5, 0.5)]
            view.Transparency = 50
            view.LineColor = (0.25, 0.25, 0.25)
    sides = (1, -1) if MIRROR_SIDE == 0 else (MIRROR_SIDE,)
    for pane in panes:
        for side in sides:
            candidates = []
            for face in pane.Shape.Faces:
                u0, u1, v0, v1 = face.ParameterRange
                normal = face.normalAt((u0 + u1)/2, (v0 + v1)/2)
                if normal.y * side > 0.99:
                    candidates.append(face)
            if not candidates:
                raise RuntimeError('Cannot identify exterior glass face: ' + pane.Label)
            face = max(candidates, key=lambda f: f.Area).copy()
            # A 0.01 mm offset prevents coincident-face display flicker.
            face.translate(App.Vector(0, side * 0.01, 0))
            coating = doc.addObject('Part::Feature', 'MirrorCoating')
            coating.Label = pane.Label.split('_')[0] + '_Exterior mirror finish'
            coating.Shape = face
            coating.addProperty('App::PropertyString', 'Finish', 'Appearance')
            coating.Finish = 'Polished silver mirror; opaque coating'
            coating.addProperty('App::PropertyLink', 'GlassPanel', 'Appearance')
            coating.GlassPanel = pane
            for parent in pane.InList:
                if parent.TypeId == 'App::Part':
                    parent.addObject(coating)
                    break
            if App.GuiUp:
                view = coating.ViewObject
                material = view.ShapeMaterial
                material.DiffuseColor = (0.82, 0.84, 0.87)
                material.SpecularColor = (1.0, 1.0, 1.0)
                material.Shininess = 100.0
                material.Transparency = 0.0
                view.ShapeMaterial = material
                view.Transparency = 0
                view.DisplayMode = 'Flat Lines'
                # Flat, glossy surface without an artificial tessellation grid.
                view.LineColor = (0.65, 0.65, 0.65)
    doc.recompute()
    doc.Label = 'French Doors - Mirror Glass'
    return doc

def install_french_doors(doc, door_root):
    import Part
    # -90 degrees about Z sends the original hinge-facing -Y to exterior -X.
    door_root.Placement = App.Placement(
        App.Vector(WALL_CENTRE_X, DOOR_CENTRE_Y, DOOR_BOTTOM_Z),
        App.Rotation(App.Vector(0, 0, 1), -90))
    cutter = Part.makeBox(200.0, OPENING_WIDTH, OPENING_HEIGHT,
                         App.Vector(WALL_CENTRE_X - 100.0,
                                    DOOR_CENTRE_Y - OPENING_WIDTH / 2.0,
                                    DOOR_BOTTOM_Z))
    changed = []
    for obj in list(doc.Objects):
        if not obj.Label.startswith('Sickenblech') or not hasattr(obj, 'Shape'):
            continue
        placement = obj.Placement
        global_placement = obj.getGlobalPlacement()
        parent_placement = global_placement.multiply(placement.inverse())
        world_shape = obj.Shape.copy()
        world_shape.Placement = parent_placement.multiply(world_shape.Placement)
        if world_shape.BoundBox.XMax > 0:
            continue
        overlap = world_shape.common(cutter)
        if overlap.Volume < 1e-5:
            continue
        # Boolean in the part's local frame: assigning a globally transformed
        # shape and then restoring Placement would apply its placement twice.
        local_shape = obj.Shape.copy()
        local_shape.Placement = App.Placement()
        local_cutter = cutter.copy()
        local_cutter.Placement = global_placement.inverse().multiply(local_cutter.Placement)
        result = local_shape.cut(local_cutter)
        if result.isNull() or not result.isValid():
            raise RuntimeError('Invalid wall cut: ' + obj.Label)
        # Attach the original component placement exactly once.
        result.Placement = placement
        obj.Shape = result
        obj.Placement = placement
        obj.addProperty('App::PropertyString', 'Modification', 'Door opening')
        obj.Modification = 'Central 1700 x 2150 mm French-door opening'
        if App.GuiUp:
            obj.ViewObject.ShapeColor = (0.5, 0.5, 0.5)
            obj.ViewObject.DiffuseColor = [(0.5, 0.5, 0.5)]
            obj.ViewObject.Transparency = 50
        changed.append(obj.Name)
    if not changed:
        raise RuntimeError('No left-wall panels intersect the door opening.')
    door_root.Label = 'French Doors - Left Wall - Hinges Outside'
    for name, value in [('OpeningWidth', OPENING_WIDTH),
                        ('OpeningHeight', OPENING_HEIGHT),
                        ('BottomElevation', DOOR_BOTTOM_Z)]:
        door_root.addProperty('App::PropertyLength', name, 'Installation')
        setattr(door_root, name, value)
    doc.Label = '20ft Container with French Doors'
    doc.recompute()
    if App.GuiUp:
        import FreeCADGui as Gui
    App.Console.PrintMessage('French doors installed; cut %d wall panels.\n' % len(changed))
    return changed

def translate_tree_to_uk_english(doc):
    import re
    # Visible labels only: FreeCAD Name identifiers and links are retained.
    replacements = [
        ('assembly_portal_links_rechts_assembly_portal_links_rechts', 'Container door assembly'),
        ('Containerdach_20ft Containerdach', '20 ft container roof assembly'),
        ('Seitenteile_Seitenteile', 'Wall assembly'),
        ('Unterboden_Unterboden', 'Floor assembly'),
        ('Portal_Portal links', 'Left container door assembly'),
        ('Portal_Portal rechts', 'Right container door assembly'),
        ('Bodenquerträger typ 1_Bodenquerträger_', 'Floor cross-member type 1 '),
        ('Bodenquerträger typ 2_Bodenlängsträger-', 'Floor cross-member type 2 '),
        ('longitudinal member links_Bodenlängsträger', 'Left floor longitudinal beam'),
        ('longitudinal member rechts_Bodenlängsträger', 'Right floor longitudinal beam'),
        ('Containerecken_unten_rechts_2025_03_30_Containerecken_unten_rechts_2025_03_30', 'Bottom right corner casting'),
        ('Containerecken_unten_links_2025_03_30_Containerecken_unten_links_2025_03_30', 'Bottom left corner casting'),
        ('Schelle_groß_Drehstangenverschluss', 'Large locking-bar clamp'),
        ('Schelle klein Drehstangenverschluss', 'Small locking-bar clamp'),
        ('Halter Handgriff Drehstange', 'Locking-bar handle bracket'),
        ('Drehstangenverschluss_rechts', 'Right locking-bar assembly'),
        ('Drehstangenverschluss', 'Locking-bar assembly'),
        ('Handgriff Container Portal_RH', 'Right-hand container door handle'),
        ('Handgriff Container Portal_LH', 'Left-hand container door handle'),
        ('Sheet forklift_Unterbodenblech-Gabeltasche', 'Forklift pocket underside plate'),
        ('Blech Gabeltasche', 'Forklift pocket plate'),
        ('Entlüftung abdeckung ABS', 'ABS ventilation cover'),
        ('Lahsing bar 1_Lahsing bar 1', 'Lashing bar 1'),
        ('Bottom end rail_Bottom end rail', 'Bottom end rail'),
        ('Door sill_Door sill', 'Door sill'),
        ('Square tube_Square tube', 'Square tube'),
        ('Verschluss handgriff', 'Handle catch'),
        ('Verschluss Nocke', 'Locking cam'),
        ('Unterlage_2_gummi', 'Rubber packing pad type 2'),
        ('Unterlage_3_gummi', 'Rubber packing pad type 3'),
        ('Unterlage_gummi', 'Rubber packing pad'),
        ('Schelle_groß', 'Large clamp'),
        ('Schelle_klein', 'Small clamp'),
        ('Portalpfosten', 'Door-frame post'),
        ('Schanierauge', 'Hinge lug'),
        ('Schanier', 'Hinge'),
        ('Verschlussblech', 'Locking plate'),
        ('Handgriff', 'Handle'),
        ('Sickenblech', 'Corrugated panel'),
        ('Rückwand', 'Rear wall panel'),
        ('Lahing Profil_vorne', 'Front lashing section'),
        ('Lahing Profil_hinten', 'Rear lashing section'),
        ('Lahsing bar', 'Lashing bar'),
        ('Holzplatte', 'Timber floor panel'),
        ('Flachstahl', 'Flat steel bar'),
        ('Gussetsheet', 'Gusset plate'),
        ('Bolzen', 'Pin'),
        ('Rohr', 'Tube'),
        ('Wie geschweißt', 'As welded'),
        ('Wie bearbeitet', 'As machined'),
        ('French glazed leaf inset', 'French door glass panel'),
        ('French glazed leaf', 'French door leaf'),
        ('501_doors_french_doors', 'French door assembly'),
    ]
    token_translations = {'links':'left', 'rechts':'right', 'oben':'upper',
                          'unten':'lower', 'vorne':'front', 'hinten':'rear',
                          'backside':'rear', 'rev':'revision'}
    for obj in doc.Objects:
        original = obj.Label
        label = re.sub(r'(?<=[A-Za-z>])(?=\d{3}$)', ' ', original)
        for source, target in replacements:
            label = label.replace(source, target)
        # Keep automatically generated instance numbers readable.
        label = re.sub(r'(?<=[A-Za-z])(?=\d{3}$)', ' ', label)
        label = label.replace('_', ' ').replace('<', ' (').replace('>', ')')
        for source, target in token_translations.items():
            label = re.sub(r'\b'+source+r'\b', target, label, flags=re.IGNORECASE)
        label = re.sub(r'\b(\d+)ft\b', r'\1 ft', label)
        label = re.sub(r'\s+', ' ', label).strip()
        # Source labels duplicate some item names around revision metadata.
        label = re.sub(r'^(Corner Casting (?:TL|TR)).*?(20250322).*$',
                       lambda m: m.group(1) + ' (2025-03-22)' +
                       (' instance ' + re.search(r'(\d{3})$', original).group(1)
                        if re.search(r'REV\d{3}$', original) else ''), label)
        if obj.Label.startswith('Rear Corner Post') and hasattr(obj, 'Shape'):
            centre = obj.getGlobalPlacement().multiply(obj.Placement.inverse()).multVec(obj.Shape.CenterOfMass)
            label = ('Left' if centre.x < 0 else 'Right') + ' rear corner post'
        label = re.sub(r'\s+', '_', label)
        if label != original:
            if 'OriginalLabel' not in obj.PropertiesList:
                obj.addProperty('App::PropertyString', 'OriginalLabel', 'Source')
            obj.OriginalLabel = original
            obj.Label = label
    doc.Label = '20_ft_container_with_French_doors'
    doc.recompute()

def import_embedded(doc, payload, digest, folder, name):
    data = lzma.decompress(base64.b85decode(payload))
    if hashlib.sha256(data).hexdigest() != digest:
        raise RuntimeError('Embedded model integrity check failed.')
    path = os.path.join(folder, name + '.step')
    with open(path, 'wb') as stream:
        stream.write(data)
    if App.GuiUp:
        import ImportGui
        ImportGui.insert(path, doc.Name)
    else:
        import Import
        Import.insert(path, doc.Name)


def set_default_camera(doc):
    if not App.GuiUp:
        return
    import FreeCADGui as Gui
    App.setActiveDocument(doc.Name)
    view = Gui.activeDocument().activeView()
    view.setCameraType('Perspective')
    node = view.getCameraNode()
    node.orientation.setValue(*(0.5643930267460263, -0.23147538977919738, -0.3126584480998956, 0.7280963879314282))
    node.position.setValue((-6494.96313245234, -6980.958950575403, 2056.470835016767))
    node.heightAngle = 0.5180065384900984
    node.focalDistance = 9754.353195205127
    node.nearDistance = 100.0
    node.farDistance = 30000.0

container_document = App.newDocument('ContainerFrenchDoors')
try:
    with tempfile.TemporaryDirectory(prefix='freecad_container_') as folder:
        import_embedded(container_document, DATA_0, HASH_0, folder, 'container')
        container_document.recompute()
        orient_and_style_container(container_document)
        container_object_names = {o.Name for o in container_document.Objects}
        import_embedded(container_document, DATA_1, HASH_1, folder, 'french_doors')
    customize_doors(container_document)
    french_door_root = next(o for o in container_document.Objects
                           if o.Name not in container_object_names
                           and o.TypeId == 'App::Part' and not o.InList)
    cut_panel_names = install_french_doors(container_document, french_door_root)
    translate_tree_to_uk_english(container_document)
    container_document.recompute()
    set_default_camera(container_document)
    App.Console.PrintMessage('Container with French doors ready.\n')
except Exception:
    App.closeDocument(container_document.Name)
    raise
