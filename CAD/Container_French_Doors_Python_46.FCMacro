# -*- coding: utf-8 -*-
# Python identifiers cannot contain %; use PERCENT in this switch.
ALL_PARTS_50_PERCENT_TRANSPARENT = False
ANIMATE_DOOR_OPENING = True
SHOW_RAT = True
ROOF_SHEET_COUNT = 7
# Actual edge-to-edge sheet run: 1090 mm sheet width, 1000 mm covering pitch.
ROOF_LENGTH = 1090 + 1000 * (ROOF_SHEET_COUNT - 1)
DOOR_OPENING_SECONDS = 8.0
# Model clearance limit: both leaves clear their jambs at 99 degrees.
DOOR_MAX_OPENING_ANGLE = 99.0
FRENCH_DOOR_WIDTH = 1800
FRENCH_DOOR_HEIGHT = 2150
FRENCH_DOOR_TO_BOX_SECTION_GAP = 5
# Millimetres from header centre to each mounting angle centre (pair spacing is twice this).
DIST_BETWEEN_CENTER_75x75x6_MOUNTING_ANGLES = 1254
# Panel seams at Y=-528.5 and +586.5 mm: midpoint gives equal header overlap.
FRENCH_DOOR_OFFSET_Y = 29.0
# Actual outer-frame dimensions in millimetres; rerun the macro after changing.

# Native Python reconstruction: no STEP, BREP, mesh, encoded blob, or file imports.
# Coordinates, analytic surfaces and rational splines are explicit construction code.
# Geometry is rebuilt using the source model's CAD tolerances.
import FreeCAD as App
import Part
from functools import lru_cache
V = App.Vector

def _surface(kind, centre, quaternion, sizes):
    if kind == 'Toroid' and sizes[1] >= sizes[0]:
        c = Part.Circle(V(0,0,0), V(0,0,1), sizes[1])
        c.transform(App.Placement(V(sizes[0],0,0), App.Rotation(V(1,0,0),90)).toMatrix())
        s = Part.SurfaceOfRevolution(c, V(0,0,0), V(0,0,1))
        s.transform(App.Placement(centre, App.Rotation(*quaternion)).toMatrix())
        return s
    s = getattr(Part, kind)()
    if kind == "Toroid":
        s.MinorRadius = 1e-12
    names = {'Plane': (), 'Cylinder': ('Radius',), 'Sphere': ('Radius',),
             'Cone': ('Radius', 'SemiAngle'), 'Toroid': ('MajorRadius', 'MinorRadius')}[kind]
    for name, value in zip(names, sizes):
        setattr(s, name, value)
    s.transform(App.Placement(centre, App.Rotation(*quaternion)).toMatrix())
    return s

def _bsurface(poles, um, vm, uk, vk, up, vp, ud, vd, weights):
    s = Part.BSplineSurface()
    s.buildFromPolesMultsKnots(poles, um, vm, uk, vk, up, vp, ud, vd, weights)
    return s

def _circle(radius, centre, quaternion, first, last):
    c = Part.Circle(V(0,0,0), V(0,0,1), radius)
    c.transform(App.Placement(centre, App.Rotation(*quaternion)).toMatrix())
    return c.toShape(first, last)

def _bsedge(poles, mults, knots, periodic, degree, weights, first, last):
    c = Part.BSplineCurve()
    c.buildFromPolesMultsKnots(poles, mults, knots, periodic, degree, weights)
    return c.toShape(first, last)

def _pole_edge(surface, p, q):
    c = Part.Geom2d.Line2dSegment(App.Base.Vector2d(*p), App.Base.Vector2d(*q))
    return c.toShape(surface)

def _edge(edge, reverse, tolerance):
    if reverse:
        edge.reverse()
    edge.fixTolerance(tolerance)
    return edge

def _wire(edges):
    # Start from a substantial edge so tiny edges with overlapping CAD
    # tolerances do not make OpenCascade choose the wrong wire orientation.
    start = max(range(len(edges)), key=lambda i: edges[i].Length)
    return Part.Wire(edges[start:] + edges[:start])

def _face(surface, wires, reverse, tolerance):
    face = Part.Face(surface, wires[0])
    for hole in wires[1:]:
        face.addWire(hole)
    face.fix(1e-7, 1e-7, tolerance)
    if (face.Orientation == 'Reversed') != reverse:
        face.reverse()
    return face

def _solid(faces):
    shell = Part.makeShell([face for item in faces for face in item.Faces])
    solid = Part.makeSolid(shell)
    if solid.Volume < 0:
        solid.reverse()
    return solid


