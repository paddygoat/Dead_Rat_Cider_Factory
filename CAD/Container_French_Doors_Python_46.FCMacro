    s=_surface('Plane',V(2.336600000000025,-1161.7499999999818,35.442609741260625),(-0.4999999999958944, -0.4999999999958944, -0.5000000000041056, 0.5000000000041056),[])
    wires=[]
    wires.append(_wire([_edge(Part.makeLine(V(0.25161031566111464,-1161.750000000001,36.497369228632145),V(1.679318735990795,-1161.750000000001,35.77511673364184)),False,1e-07),_edge(_circle(0.736599999999997,V(2.336600000000025,-1161.7499999999818,35.442609741260625),(-0.4999999999958974, 0.4999999999958915, 0.5000000000041027, 0.5000000000041086),1.570796326795014,2.03913873698332),True,1e-07),_edge(Part.makeLine(V(0.0,-1161.7499999999818,35.442609741260625),V(1.6,-1161.7499999999818,35.442609741260625)),True,1e-07),_edge(_circle(2.336600000000001,V(2.336600000000025,-1161.7499999999818,35.442609741260625),(-0.4999999999958935, 0.4999999999958953, 0.5000000000041065, 0.5000000000041047),1.570796326794927,2.039138736983221),False,1e-07)]))
    faces.append(_face(s,wires,True,0.0001))
    s=_surface('Cylinder',V(2.336600000000025,12779.25,35.44260974126229),(0.5000000000000001, 0.5000000000000001, -0.5, 0.5),[0.736599999999997])
    wires=[]
    wires.append(_wire([_edge(Part.makeLine(V(1.6793187359908022,1161.7499999999836,35.77511673364213),V(1.6793187359909183,-1161.750000000001,35.77511673364208)),True,1e-07),_edge(_circle(0.736599999999997,V(2.336600000000025,1161.7499999999836,35.4426097412609),(0.49999999999631706, -0.4999999999963156, 0.500000000003683, 0.5000000000036845),1.102453916606577,1.570796326794794),False,1e-07),_edge(Part.makeLine(V(1.6000000000000247,1161.75,35.442609741260895),V(1.6000000000000247,-1161.75,35.44260974126062)),False,1e-07),_edge(_circle(0.736599999999997,V(2.336600000000025,-1161.7499999999818,35.442609741260625),(-0.4999999999958974, 0.4999999999958915, 0.5000000000041027, 0.5000000000041086),1.570796326795014,2.03913873698332),False,1e-07)]))
    faces.append(_face(s,wires,True,0.0001))
    s=_surface('Cylinder',V(2.336600000000025,12779.25,35.44260974126229),(0.5000000000000001, 0.5000000000000001, -0.5, 0.5),[2.336600000000001])
    wires=[]
    wires.append(_wire([_edge(_circle(2.336600000000001,V(2.336600000000025,-1161.7499999999818,35.442609741260625),(-0.4999999999958935, 0.4999999999958953, 0.5000000000041065, 0.5000000000041047),1.570796326794927,2.039138736983221),False,1e-07),_edge(Part.makeLine(V(0.25161031566111464,1161.7499999999836,36.49736922863242),V(0.25161031566111464,-1161.7499999999818,36.497369228632145)),True,1e-07),_edge(_circle(2.336600000000001,V(2.336600000000025,1161.7499999999836,35.4426097412609),(0.49999999999631717, -0.4999999999963154, 0.5000000000036828, 0.5000000000036846),1.102453916606572,1.5707963267949),False,1e-07),_edge(Part.makeLine(V(0.0,1161.7499999999836,35.442609741260895),V(0.0,-1161.75,35.44260974126062)),False,1e-07)]))
    faces.append(_face(s,wires,False,0.0001))
    solids.append(_solid(faces))
    return solids[0] if len(solids)==1 else Part.makeCompound(solids)

def door_support_dimensions():
    gap = float(FRENCH_DOOR_TO_BOX_SECTION_GAP)
    if not 0 <= gap <= 50:
        raise ValueError('FRENCH_DOOR_TO_BOX_SECTION_GAP must be 0..50 mm.')
    # Corrugation extrema -1211..-1175 mm lie inside the 38 mm flat
    # face (-1212..-1174): the ENTIRE cut sheet edge contacts the steel.
    return -1193.0, FRENCH_DOOR_WIDTH/2.0+gap, -1127.5, -1127.5+FRENCH_DOOR_HEIGHT+gap


def rounded_shs(length):
    # Nominal cold-formed 50x50x3 SHS: external R6, internal R3.
    # Actual EN10219 stock corner profiles vary (1.6t..2.4t externally).
    # https://www.tatasteeluk.com/construction/products/tube/structural-hollow-sections/hybox
    # Circular tangent arcs and concentric internal arcs retain 3 mm walls.
    def rounded_prism(size, radius):
        solid=Part.makeBox(size,size,length,V(-size/2,-size/2,0))
        edges=[e for e in solid.Edges if e.BoundBox.ZLength>length-1e-6]
        return solid.makeFillet(radius,edges)
    return rounded_prism(50,6).cut(rounded_prism(44,3))


def add_door_steel_surround(doc):
    x, inner, bottom, head_bottom = door_support_dimensions()
    outer=inner+50; top=head_bottom+50
    group=doc.addObject('App::Part','Door_Steel_Surround')
    group.Label='Door_Steel_Surround'
    group.Placement.Base = V(0,float(FRENCH_DOOR_OFFSET_Y),0)
    def clip(points):
        wire=Part.makePolygon([V(x-100,y,z) for y,z in points+[points[0]]])
        return Part.Face(wire).extrude(V(200,0,0))
    def member(name, shape):
        obj=doc.addObject('Part::Feature',name);obj.Label=name
        obj.Shape=shape.removeSplitter();group.addObject(obj)
        for prop,value in [('Section_Width',50),('Wall_Thickness',3),
                           ('External_Radius',6),('Internal_Radius',3)]:
            obj.addProperty('App::PropertyLength',prop,'Steel_Section');setattr(obj,prop,value)
        obj.addProperty('App::PropertyString','Fabrication_Note','Steel_Section')
        obj.Fabrication_Note='50x50x3 SHS; nominal R6/R3; 45 degree top mitres; verify supplied stock radii. Continuous sheet-edge contact, no weld bead modelled.'
        if name=='Door_Steel_Mitred_Header':
            obj.Label='Top_50x50x3_mitered_box'
            obj.addProperty('App::PropertyString','Section_Details','Steel_Section')
            obj.Section_Details=obj.Fabrication_Note
            obj.Fabrication_Note='Top 50x50x3 mitered box'
        return obj
    for sign,name in [(1,'Door_Steel_Upright_Positive_Y'),(-1,'Door_Steel_Upright_Negative_Y')]:
        shape=rounded_shs(top-bottom)
        shape.translate(V(x,sign*(inner+25),bottom))
        polygon=[(sign*inner,bottom),(sign*outer,bottom),
                 (sign*outer,top),(sign*inner,head_bottom)]
        member(name,shape.common(clip(polygon)))
    head=rounded_shs(2*outer)
    head.rotate(V(0,0,0),V(1,0,0),-90)
    head.translate(V(x,-outer,head_bottom+25))
    member('Door_Steel_Mitred_Header',head.common(clip(
        [(-outer,top),(outer,top),(inner,head_bottom),(-inner,head_bottom)])))
    return group


def equal_angle_75x75x6(length=150):
    # Nominal EN/UK equal-angle profile: root R9, toe R4.5, 6 mm flats.
    # https://www.stainless-structurals.com/wp-content/uploads/2015/05/Montanstahl-Equal-Angles-Data-Sheet.pdf
    # Cross-sectional area = 872.691374 mm2; retain the real rounded toes.
    pts=[V(0,0,0),V(75,0,0),V(75,6,0),V(6,6,0),V(6,75,0),V(0,75,0),V(0,0,0)]
    solid=Part.Face(Part.makePolygon(pts)).extrude(V(0,0,length))
    def longitudinal_edges(shape,points):
        return [e for e in shape.Edges if abs(e.BoundBox.ZLength-length)<1e-6
                and any(abs(e.CenterOfMass.x-x)<1e-6 and abs(e.CenterOfMass.y-y)<1e-6 for x,y in points)]
    solid=solid.makeFillet(9,longitudinal_edges(solid,[(6,6)]))
    return solid.makeFillet(4.5,longitudinal_edges(solid,[(75,6),(6,75)]))


def add_rail_angle_pair(doc, rail_name, group_name, prefix, floor=False):
    rail=doc.getObject(rail_name)
    shape=rail.Shape.copy();shape.Placement=rail.getGlobalPlacement()
    box=shape.BoundBox
    mounting_x=box.XMin
    if floor:
        # Find the actual outward-facing main web, not the narrow outer lip.
        faces=[f for f in shape.Faces if f.BoundBox.XLength<1e-5
               and f.normalAt(0,0).x < -0.99]
        mounting_x=max(faces,key=lambda f:f.Area).BoundBox.XMin
    header=doc.getObject('Door_Steel_Mitred_Header')
    header_shape=header.Shape.copy();header_shape.Placement=header.getGlobalPlacement()
    centre_y=header_shape.BoundBox.Center.y
    group=doc.addObject('App::Part',group_name);group.Label=group_name
    for side,name in [(-1,prefix+'_Front'),(1,prefix+'_Rear')]:
        # Vertical 150 mm length, centred on the rail height. One flat leg is
        # flush to its exterior (-X) face; each angle is then turned 180 degrees about its own X centreline.
        y=centre_y+side*1325.0
        transform=App.Matrix()
        transform.A11=-1;transform.A22=side;transform.A33=1
        transform.A14=mounting_x;transform.A24=y-side*37.5
        transform.A34=box.Center.z-75
        angle=equal_angle_75x75x6().transformGeometry(transform)
        angle.rotate(angle.BoundBox.Center,V(1,0,0),180)
        if floor:
            # Full uncut angle: run its 150 mm length along Y so the 75 mm
            # mounting leg fits within the main web's clear vertical height.
            angle.rotate(angle.BoundBox.Center,V(1,0,0),90)
            web=max(faces,key=lambda f:f.Area)
            angle.translate(V(0,0,web.BoundBox.Center.z-angle.BoundBox.Center.z))
            if angle.common(shape).Volume>1e-4:
                raise ValueError('Uncut floor mounting angle clashes with beam at selected spacing.')
        obj=doc.addObject('Part::Feature',name);obj.Label=name;obj.Shape=angle
        group.addObject(obj)
        for prop,val in [('Leg_Size',75),('Thickness',6),('Cut_Length',150),
                         ('Root_Radius',9),('Toe_Radius',4.5),('Header_Centre_Offset',1325)]:
            obj.addProperty('App::PropertyLength',prop,'Angle_Section');setattr(obj,prop,val)
        obj.addProperty('App::PropertyString','Mounting_Rail','Angle_Section');obj.Mounting_Rail=rail.Name
        obj.addProperty('App::PropertyBool','Coped_To_Beam','Angle_Section');obj.Coped_To_Beam=False
        obj.addProperty('App::PropertyFloat','Coping_Removed_mm3','Angle_Section');obj.Coping_Removed_mm3=0
        obj.addProperty('App::PropertyString','Section_Note','Angle_Section')
        obj.Section_Note='75x75x6 equal angle, nominal EN/UK R9 root and R4.5 toes; 150 mm vertical; centre-to-header-centre spacing; rotated 180 degrees about its bounding-box centre in X.'
        if floor:obj.Section_Note='75x75x6 equal angle, nominal R9 root and R4.5 toes; full uncut 150 mm length along Y; flat leg flush against main vertical web, centred within its clear height.'
    return group

def add_panel_angle_pair(doc, bottom=False):
    rail=doc.getObject('Part__Feature005')
    rail_shape=rail.Shape.copy();rail_shape.Placement=rail.getGlobalPlacement()
    header=doc.getObject('Door_Steel_Mitred_Header')
    hs=header.Shape.copy();hs.Placement=header.getGlobalPlacement()
    centre_y=hs.BoundBox.Center.y
    prefix='Bottom_Panel_Angle' if bottom else 'Top_Rail_Angle'
    group=doc.addObject('App::Part','Bottom_Panel_Angles' if bottom else 'Top_Rail_Angles')
    group.Label=group.Name
    for side,suffix,panel_name in [(-1,'Front','Part__Feature084'),(1,'Rear','Part__Feature082')]:
        panel=doc.getObject(panel_name)
        ps=panel.Shape.copy();ps.Placement=panel.getGlobalPlacement()
        y=centre_y+side*float(DIST_BETWEEN_CENTER_75x75x6_MOUNTING_ANGLES)
        x=ps.BoundBox.XMin
        m=App.Matrix();m.A11=-1;m.A22=side;m.A33=1
        m.A14=x;m.A24=y-side*37.5
        m.A34=ps.BoundBox.ZMin if bottom else rail_shape.BoundBox.ZMin-150
        angle=equal_angle_75x75x6().transformGeometry(m)
        angle.rotate(angle.BoundBox.Center,V(1,0,0),180)
        if not bottom:
            # The panel crest lies outside the rail's flat underside. Locate
            # its rounded underside along the angle's back edge, without overlap.
            probe=Part.makeLine(V(x,y,rail_shape.BoundBox.ZMin-1),
                                V(x,y,rail_shape.BoundBox.ZMax+1))
            hits=rail_shape.section(probe).Vertexes
            if not hits:raise ValueError('No top rail above panel mounting angle.')
            underside=min(v.Point.z for v in hits)
            angle.translate(V(0,0,underside-angle.BoundBox.ZMax))
        if angle.common(ps).Volume>1e-4 or angle.common(rail_shape).Volume>1e-4:
            raise ValueError('Panel mounting angle clashes at selected spacing.')
        obj=doc.addObject('Part::Feature',prefix+'_'+suffix);obj.Label=obj.Name
        obj.Shape=angle;group.addObject(obj)
        for prop,val in [('Leg_Size',75),('Thickness',6),('Cut_Length',150),
                         ('Root_Radius',9),('Toe_Radius',4.5),
                         ('Header_Centre_Offset',DIST_BETWEEN_CENTER_75x75x6_MOUNTING_ANGLES)]:
            obj.addProperty('App::PropertyLength',prop,'Angle_Section');setattr(obj,prop,val)
        obj.addProperty('App::PropertyString','Mounting_Panel','Angle_Section');obj.Mounting_Panel=panel.Label
        obj.addProperty('App::PropertyString','Section_Note','Angle_Section')
        obj.Section_Note='Full uncut 75x75x6 angle; R9 root/R4.5 toes; 150 mm vertical, against outer corrugation crest. '+('Bottom aligned with panel bottom.' if bottom else 'Top edge touches rounded rail underside; contact is along an edge, not the flat underside face.')
    return group


def add_top_rail_angles(doc):
    return add_panel_angle_pair(doc)


def add_bottom_panel_angles(doc):
    return add_panel_angle_pair(doc,True)


def add_floor_beam_angles(doc):
    return add_rail_angle_pair(doc,'Part__Feature384','Floor_Beam_Angles','Floor_Beam_Angle',True)



def add_timber_posts(doc):
    beam=doc.getObject('Part__Feature384')
    bs=beam.Shape.copy();bs.Placement=beam.getGlobalPlacement()
    group=doc.addObject('App::Part','Timber_Posts');group.Label='Timber_Posts'
    # Seen from the left wall: mount outside the projecting angle legs,
    # away from the opening. Offset X enough to also clear the floor brackets.
    for side,suffix in [(-1,'Front'),(1,'Rear')]:
        upper=doc.getObject('Top_Rail_Angle_'+suffix).Shape.BoundBox
        y=upper.YMin-98 if side<0 else upper.YMax
        obj=doc.addObject('Part::Feature','Timber_Post_'+suffix)
        obj.Label=obj.Name
        floor_angle=doc.getObject('Floor_Beam_Angle_'+suffix).Shape.BoundBox
        inner_x=min(upper.XMax,floor_angle.XMin,bs.BoundBox.XMin)
        obj.Shape=Part.makeBox(98,98,4000,V(inner_x-98,y,bs.BoundBox.ZMin))
        group.addObject(obj)
        for prop,val in [('Width',98),('Depth',98),('Height',4000)]:
            obj.addProperty('App::PropertyLength',prop,'Timber');setattr(obj,prop,val)
        obj.addProperty('App::PropertyString','Material_Specification','Timber')
        obj.Material_Specification='Wood; yellow opaque in production; grey 50 percent transparent in inspection mode.'
    return group


def organise_timber_angle_assemblies(doc):
    # Each assembly contains one timber, its upper/lower panel brackets and
    # the retained floor-web bracket. Keep separate editable solids.
    for suffix,old_panel,new_panel in [('Front','Part__Feature084','Part__Feature085'),
                                       ('Rear','Part__Feature082','Part__Feature040')]:
        original=doc.getObject(old_panel);target=doc.getObject(new_panel)
        a=original.Shape.copy();a.Placement=original.getGlobalPlacement()
        b=target.Shape.copy();b.Placement=target.getGlobalPlacement()
        shift=b.BoundBox.Center.y-a.BoundBox.Center.y
        members=[doc.getObject(prefix+suffix) for prefix in
                 ['Timber_Post_','Top_Rail_Angle_','Bottom_Panel_Angle_','Floor_Beam_Angle_']]
        for panel,offset,duplicate in [(original,0,False),(target,shift,True)]:
            label='Timber_Angle_Assembly_'+panel.Label
            assembly=doc.addObject('App::Part',label);assembly.Label=label
            assembly.addProperty('App::PropertyString','Mounting_Panel','Assembly')
            assembly.Mounting_Panel=panel.Label
            for source in members:
                obj=source
                if duplicate:
                    obj=doc.addObject('Part::Feature',source.Name+'_'+panel.Label)
                    obj.Label=obj.Name
                    translated=source.Shape.copy();translated.translate(V(0,offset,0));obj.Shape=translated
                    for prop in source.PropertiesList:
                        if source.getGroupOfProperty(prop) not in ['Timber','Angle_Section']:continue
                        obj.addProperty(source.getTypeIdOfProperty(prop),prop,source.getGroupOfProperty(prop))
                        setattr(obj,prop,getattr(source,prop))
                    if 'Mounting_Panel' in obj.PropertiesList:obj.Mounting_Panel=panel.Label
                    if 'Header_Centre_Offset' in obj.PropertiesList:
                        obj.Header_Centre_Offset=float(source.Header_Centre_Offset)+abs(offset)
                else:
                    for parent in list(obj.InList):
                        if parent.TypeId=='App::Part':parent.removeObject(obj)
                assembly.addObject(obj)
    for name in ['Timber_Posts','Top_Rail_Angles','Bottom_Panel_Angles','Floor_Beam_Angles']:
        group=doc.getObject(name)
        if group is not None and not group.Group:doc.removeObject(name)


def add_right_timber_angle_assemblies(doc):
    # Reflect complete left-side assemblies in the container centre plane X=0.
    # Keeping Y and Z unchanged aligns opposite uprights along global X.
    reflection=App.Matrix();reflection.A11=-1
    originals=[o for o in doc.Objects if o.TypeId=='App::Part'
               and o.Name.startswith('Timber_Angle_Assembly_')]
    for source_group in originals:
        name=source_group.Label+'_RHS'
        group=doc.addObject('App::Part',name);group.Label=name
        group.addProperty('App::PropertyString','Mirrored_From','Assembly')
        group.Mirrored_From=source_group.Name
        for source in source_group.Group:
            obj=doc.addObject('Part::Feature',source.Name+'_RHS');obj.Label=obj.Name
            shape=source.Shape.copy();shape.Placement=source.getGlobalPlacement()
            obj.Shape=shape.transformGeometry(reflection)
            for prop in source.PropertiesList:
                if source.getGroupOfProperty(prop) not in ['Timber','Angle_Section']:continue
                # Do not retain left-side mounting references on mirrored parts.
                if prop in ['Mounting_Panel','Mounting_Rail']:continue
                obj.addProperty(source.getTypeIdOfProperty(prop),prop,source.getGroupOfProperty(prop))
                setattr(obj,prop,getattr(source,prop))
            group.addObject(obj)


def move_outer_timber_assemblies(doc):
    # Requested outer end movements; RHS front request names only the post.
    for name,dy in [
        ('Timber_Angle_Assembly_Corrugated_panel',275),
        ('Timber_Angle_Assembly_Corrugated_panel_RHS',275),
        ('Timber_Post_Front_Corrugated_panel_005_RHS',-275),
        ('Timber_Angle_Assembly_Corrugated_panel_005',-275)]:
        obj=doc.getObject(name)
        if obj is None:raise ValueError('Missing object for Y move: '+name)
        placement=obj.Placement
        placement.Base=placement.Base+V(0,dy,0)
        obj.Placement=placement


def shorten_timber_posts(doc):
    # Keep each object's placement and local bottom unchanged; trim only its top.
    for obj in doc.Objects:
        if obj.TypeId!='Part::Feature' or not obj.Name.startswith('Timber_Post_'):continue
        height=2790 if obj.Name.endswith('_RHS') else 3100
        placement=obj.Placement
        local=obj.Shape.copy();local.Placement=App.Placement()
        box=local.BoundBox
        obj.Shape=Part.makeBox(box.XLength,box.YLength,height,V(box.XMin,box.YMin,box.ZMin))
        obj.Placement=placement
        obj.Height=height


def add_left_timber_crossbeam(doc):
    bounds=[]
    for name in ['Timber_Post_Rear_Corrugated_panel','Timber_Post_Front_Corrugated_panel_005']:
        obj=doc.getObject(name)
        shape=obj.Shape.copy();shape.Placement=obj.getGlobalPlacement()
        bounds.append(shape.BoundBox)
    rear,front=bounds
    if abs(rear.ZMax-front.ZMax)>1e-6 or abs(rear.XMin-front.XMin)>1e-6:
        raise ValueError('Left crossbeam requires aligned post tops and left faces.')
    # 200 mm vertical depth, 45 mm X thickness, roof-run length along global Y.
    centre_y=(rear.Center.y+front.Center.y)/2
    obj=doc.addObject('Part::Feature','Timber_Crossbeam_LHS')
    obj.Label='Timber_Crossbeam_LHS'
    obj.Shape=Part.makeBox(45,ROOF_LENGTH,200,V(front.XMin-45,centre_y-ROOF_LENGTH/2,front.ZMax-200))
    for prop,val in [('Depth',200),('Thickness',45),('Length',ROOF_LENGTH)]:
        obj.addProperty('App::PropertyLength',prop,'Timber');setattr(obj,prop,val)
    obj.addProperty('App::PropertyString','Material_Specification','Timber')
    obj.Material_Specification='Wood; yellow opaque in production; grey 50 percent transparent in inspection mode.'
    return obj


def add_right_timber_crossbeam(doc):
    bounds=[]
    for name in ['Timber_Post_Rear_Corrugated_panel_RHS','Timber_Post_Front_Corrugated_panel_005_RHS']:
        obj=doc.getObject(name)
        shape=obj.Shape.copy();shape.Placement=obj.getGlobalPlacement()
        bounds.append(shape.BoundBox)
    rear,front=bounds
    if abs(rear.ZMax-front.ZMax)>1e-6 or abs(rear.XMax-front.XMax)>1e-6:
        raise ValueError('Right crossbeam requires aligned post tops and right faces.')
    # 200 mm vertical depth, 45 mm X thickness, roof-run length along global Y.
    centre_y=(rear.Center.y+front.Center.y)/2
    obj=doc.addObject('Part::Feature','Timber_Crossbeam_RHS')
    obj.Label='Timber_Crossbeam_RHS'
    obj.Shape=Part.makeBox(45,ROOF_LENGTH,200,V(front.XMax,centre_y-ROOF_LENGTH/2,front.ZMax-200))
    for prop,val in [('Depth',200),('Thickness',45),('Length',ROOF_LENGTH)]:
        obj.addProperty('App::PropertyLength',prop,'Timber');setattr(obj,prop,val)
    obj.addProperty('App::PropertyString','Material_Specification','Timber')
    obj.Material_Specification='Wood; yellow opaque in production; grey 50 percent transparent in inspection mode.'
    return obj


def add_timber_end_beams(doc):
    lhs=doc.getObject('Timber_Crossbeam_LHS').Shape.BoundBox
    rhs=doc.getObject('Timber_Crossbeam_RHS').Shape.BoundBox
    x0,x1=lhs.XMax,rhs.XMin
    z0,z1=lhs.ZMax,rhs.ZMax
    slope=(z1-z0)/(x1-x0)
    # True 200 mm section depth perpendicular to the sloping top; vertical
    # end cuts fit the inside faces of the longitudinal beams without overlap.
    depth=200*(1+slope*slope)**0.5
    front_y=max(lhs.YMin,rhs.YMin)
    rear_y=min(lhs.YMax,rhs.YMax)-45
    positions=[('Front',front_y)]+[
        ('Intermediate_%02d'%i,front_y+(rear_y-front_y)*i/4) for i in range(1,4)
    ]+[('Rear',rear_y)]
    for suffix,y in positions:
        points=[V(x0,y,z0),V(x1,y,z1),V(x1,y,z1-depth),
                V(x0,y,z0-depth),V(x0,y,z0)]
        obj=doc.addObject('Part::Feature','Timber_End_Beam_'+suffix);obj.Label=obj.Name
        obj.Shape=Part.Face(Part.makePolygon(points)).extrude(V(0,45,0))
        for prop,val in [('Section_Depth',200),('Thickness',45),('Clear_Span',x1-x0),
                         ('Sloping_Length',((x1-x0)**2+(z1-z0)**2)**0.5)]:
            obj.addProperty('App::PropertyLength',prop,'Timber');setattr(obj,prop,val)
        obj.addProperty('App::PropertyString','Material_Specification','Timber')
        obj.Material_Specification='Wood; yellow opaque in production; grey 50 percent transparent in inspection mode. 200 mm normal section depth; plumb-cut ends; top meets each side beam top at its inside face.'


def add_roof_timber_battens(doc):
    lhs=doc.getObject('Timber_Crossbeam_LHS').Shape.BoundBox
    rhs=doc.getObject('Timber_Crossbeam_RHS').Shape.BoundBox
    front=doc.getObject('Timber_End_Beam_Front').Shape.BoundBox
    rear=doc.getObject('Timber_End_Beam_Rear').Shape.BoundBox
    along=V(rhs.XMin-lhs.XMax,0,rhs.ZMax-lhs.ZMax)
    width_direction=along/along.Length
    normal=V(-width_direction.z,0,width_direction.x)
    # 25 mm across the slope, 50 mm upright normal to the roof plane.
    # First/last bottom edges align to the ends of the transverse timbers.
    group=doc.addObject('App::Part','Roof_Timber_Battens');group.Label=group.Name
    for i in range(5):
        start=V(lhs.XMax,front.YMin,lhs.ZMax)+width_direction*((along.Length-25)*i/4)
        points=[start,start+width_direction*25,
                start+width_direction*25+normal*50,start+normal*50,start]
        obj=doc.addObject('Part::Feature','Timber_Batten_%02d'%(i+1));obj.Label=obj.Name
        obj.Shape=Part.Face(Part.makePolygon(points)).extrude(V(0,rear.YMax-front.YMin,0))
        group.addObject(obj)
        for prop,val in [('Width',25),('Height',50),('Length',rear.YMax-front.YMin),
                         ('Centre_Spacing_On_Slope',(along.Length-25)/4)]:
            obj.addProperty('App::PropertyLength',prop,'Timber');setattr(obj,prop,val)
        obj.addProperty('App::PropertyString','Material_Specification','Timber')
        obj.Material_Specification='Wood; 50 mm upright normal to roof, 25 mm across slope; yellow opaque in production; grey 50 percent transparent in inspection mode.'


def box_profile_sheet_section():
    # Nominal 32/1000 unswaged profile: 200 pitch, 70 rib base, 24 crown.
    # Main dimensions: Briarwood Box Profiled Metal Sheets, March 2026, p6.
    # Requested 0.8 gauge; assumed inside bend R1.6 and 30 mm front fixing tab.
    import math
    # Front lap tab is slightly raised to receive the adjacent underlap valley.
    points=[V(0,1.6,0)]
    for i in range(5):
        x=30+200*i
        points.extend([V(x,1.6 if i==0 else 0.4,0),V(x+23,31.6,0),
                       V(x+47,31.6,0),V(x+70,0.4,0)])
    # Sixth ridge is narrower/lower to fit inside the first ridge of the next
    # sheet at exactly 1000 mm pitch. Its descending flank is cut at 1090 mm.
    points.extend([V(1031.5,0.4,0),V(1054,30.4,0),V(1076,30.4,0),
                   V(1098.5,0.4,0),V(1110,0.4,0)])
    radius=2.0 # neutral-line radius; surfaces R1.6/R2.4
    corners=[]
    for a,b,c in zip(points,points[1:],points[2:]):
        u=b-a;u.normalize();v=c-b;v.normalize()
        turn=1 if u.cross(v).z>0 else -1
        tangent=radius*math.tan(math.acos(max(-1,min(1,u.dot(v))))/2)
        first=b-u*tangent;last=b+v*tangent
        centre=first+V(-u.y,u.x,0)*(radius*turn)
        corners.append((first,last,centre,u,v,turn))
    def boundary(offset):
        u=points[1]-points[0];u.normalize()
        start=points[0]+V(-u.y,u.x,0)*offset
        previous=start;edges=[]
        for first,last,centre,u,v,turn in corners:
            a=first+V(-u.y,u.x,0)*offset
            b=last+V(-v.y,v.x,0)*offset
            edges.append(Part.makeLine(previous,a))
            middle=(a-centre)+(b-centre);middle.normalize()
            middle=centre+middle*(radius-turn*offset)
            edges.append(Part.Arc(a,middle,b).toShape());previous=b
        u=points[-1]-points[-2];u.normalize()
        end=points[-1]+V(-u.y,u.x,0)*offset
        edges.append(Part.makeLine(previous,end))
        return edges,start,end
    upper,us,ue=boundary(0.4);lower,ls,le=boundary(-0.4)
    edges=upper+[Part.makeLine(ue,le)]
    for edge in reversed(lower):
        edge=edge.copy();edge.reverse();edges.append(edge)
    edges.append(Part.makeLine(ls,us))
    section=Part.Face(Part.Wire(edges))
    trim=Part.Face(Part.makePolygon([V(0,-1,0),V(1090,-1,0),V(1090,40,0),V(0,40,0),V(0,-1,0)]))
    return section.common(trim).Faces[0]


def add_front_roofing_sheet(doc):
    lhs=doc.getObject('Timber_Crossbeam_LHS').Shape.BoundBox
    rhs=doc.getObject('Timber_Crossbeam_RHS').Shape.BoundBox
    front=doc.getObject('Timber_End_Beam_Front').Shape.BoundBox
    along=V(rhs.XMin-lhs.XMax,0,rhs.ZMax-lhs.ZMax)
    span=along.Length;along.normalize()
    normal=V(-along.z,0,along.x)
    origin=V(lhs.XMax,front.YMin,lhs.ZMax)+normal*50-along*((3000-span)/2)
    # Local X = sheet width towards rear; local Y = roof normal; Z = downslope.
    m=App.Matrix()
    m.A11=0;m.A21=1;m.A31=0
    m.A12=normal.x;m.A22=normal.y;m.A32=normal.z
    m.A13=along.x;m.A23=along.y;m.A33=along.z
    m.A14=origin.x;m.A24=origin.y;m.A34=origin.z
    obj=doc.addObject('Part::Feature','Roofing_Sheet_Front');obj.Label=obj.Name
    obj.Shape=box_profile_sheet_section().extrude(V(0,0,3000)).transformGeometry(m)
    for prop,val in [('Sheet_Length',3000),('Overall_Width',1090),('Nominal_Cover',1000),
                     ('Steel_Thickness',0.8),('Profile_Depth',32),('Rib_Pitch',200),
                     ('Front_Fixing_Tab',30),('Inside_Bend_Radius',1.6)]:
        obj.addProperty('App::PropertyLength',prop,'Roofing');setattr(obj,prop,val)
    obj.addProperty('App::PropertyString','Profile_Note','Roofing')
    obj.Profile_Note='Six-ridge 32/1000-style profile: five full ribs and a narrowed/lowered partial sixth underlap rib, cut at 1090 mm overall. Sheets nest at 1000 mm cover pitch, giving 90 mm sidelap. Front (-Y) fixing/lap tab retained. True 0.8 mm steel gauge with R1.6 internal bends. Edge clearance geometry is a modelled fit, not a supplier-certified section.'
    return obj


def add_remaining_roofing_sheets(doc):
    source=doc.getObject('Roofing_Sheet_Front')
    for index in range(2,ROOF_SHEET_COUNT+1):
        obj=doc.addObject('Part::Feature','Roofing_Sheet_%02d'%index);obj.Label=obj.Name
        shape=source.Shape.copy();shape.Placement=source.getGlobalPlacement()
        # Full front ridge overlaps the preceding partial rear ridge.
        shape.translate(V(0,1000*(index-1),0));obj.Shape=shape
        for prop in source.PropertiesList:
            if source.getGroupOfProperty(prop)=='Roofing':
                obj.addProperty(source.getTypeIdOfProperty(prop),prop,'Roofing')
                setattr(obj,prop,getattr(source,prop))
        obj.addProperty('App::PropertyLength','Sheet_Pitch','Roofing');obj.Sheet_Pitch=1000
        obj.addProperty('App::PropertyLength','Side_Lap','Roofing');obj.Side_Lap=90


def add_left_rear_side_battens(doc):
    bounds=[]
    for name in ['Timber_Post_Rear_Corrugated_panel','Timber_Post_Rear']:
        obj=doc.getObject(name)
        shape=obj.Shape.copy();shape.Placement=obj.getGlobalPlacement()
        bounds.append(shape.BoundBox)
    a,b=bounds
    if abs(a.XMin-b.XMin)>1e-6 or abs(a.ZMin-b.ZMin)>1e-6:
        raise ValueError('Side battens require aligned post faces and bottoms.')
    centre_y=(a.Center.y+b.Center.y)/2
    group=doc.addObject('App::Part','LHS_Rear_Side_Battens');group.Label=group.Name
    for i in range(4):
        obj=doc.addObject('Part::Feature','Timber_Batten_LHS_Rear_%02d'%(i+1));obj.Label=obj.Name
        obj.Shape=Part.makeBox(25,2000,50,V(a.XMin-25,centre_y-1000,a.ZMin+100+900*i))
        group.addObject(obj)
        for prop,val in [('Width',25),('Height',50),('Length',2000),('Vertical_Centre_Spacing',900),
                         ('Bottom_Edge_Above_Post_Base',100+900*i)]:
            obj.addProperty('App::PropertyLength',prop,'Timber');setattr(obj,prop,val)
        obj.addProperty('App::PropertyString','Material_Specification','Timber')
        obj.Material_Specification='Wood; 50 mm vertical x 25 mm thick; yellow opaque or grey 50 percent transparent according to global toggle.'


