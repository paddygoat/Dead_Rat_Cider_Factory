container_document=build_model()

# Release temporary construction caches after the document owns the geometry.
for _builder in list(globals().values()):
    if callable(_builder) and getattr(_builder, "__name__", "").startswith("shape_"):
        _builder.cache_clear()

# Capture the reset state and print instructions before starting playback.
install_animation_restart(container_document)
animate_door_opening(container_document)
