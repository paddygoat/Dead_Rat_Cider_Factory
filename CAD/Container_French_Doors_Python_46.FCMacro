    wires.append(_wire([_edge(Part.makeLine(V(672.2000838926174,-258.6577181208053,0.0),V(751.667365771812,-258.6577181208053,0.0)),True,1.0000000000000002e-07),_edge(Part.makeLine(V(779.6036073825503,-421.7827181208054,0.0),V(672.2000838926174,-258.6577181208054,0.0)),True,1.0000000000000002e-07),_edge(Part.makeLine(V(779.6036073825503,-540.5369127516778,0.0),V(779.6036073825503,-421.7827181208054,0.0)),True,1.0000000000000002e-07),_edge(Part.makeLine(V(852.2755872483222,-540.5369127516778,0.0),V(779.6036073825503,-540.5369127516778,0.0)),True,1.0000000000000002e-07),_edge(Part.makeLine(V(852.2755872483222,-421.7827181208054,0.0),V(852.2755872483222,-540.5369127516778,0.0)),True,1.0000000000000002e-07),_edge(Part.makeLine(V(959.6791107382551,-258.6577181208053,0.0),V(852.2755872483222,-421.7827181208054,0.0)),True,1.0000000000000002e-07),_edge(Part.makeLine(V(880.0230704697988,-258.6577181208053,0.0),V(959.6791107382552,-258.6577181208053,0.0)),True,1.0000000000000002e-07),_edge(Part.makeLine(V(815.8452181208054,-359.10234899328856,0.0),V(880.0230704697987,-258.6577181208053,0.0)),True,1.0000000000000002e-07),_edge(Part.makeLine(V(751.6673657718122,-258.6577181208053,0.0),V(815.8452181208055,-359.10234899328856,0.0)),True,1.0000000000000002e-07)]))
    faces.append(_face(s,wires,False,0.0001))
    face = faces[0] if len(faces)==1 else Part.makeCompound(faces)
    face.scale(scale)
    obj = doc.addObject("Part::Feature", "SignLetter_3_7_Y")
    obj.Label = "Sign_3_07_Y"
    obj.Shape = face.extrude(V(0,0,2))
    group.addObject(obj)
    objects[obj.Name] = obj
    return group

def add_factory_rat(doc):
    if not SHOW_RAT:
        return
    import math
    group=doc.addObject('App::Part','FactoryRat')
    group.Label='Factory_Rat'
    # Life-sized seated adult: approximately 230 mm high; offset from floor centre is (-250,+650) mm.
    direction=V(-9577.23776321+250,-4305.45248248-650,0)
    group.Placement=App.Placement(V(-250,650,-1128.5),App.Rotation(V(1,0,0),direction))
    brown=(0.25,0.21,0.18); skin=(0.58,0.37,0.35)
    def part(name,shape,colour):
        o=doc.addObject('Part::Feature','Rat_'+name);o.Label='Rat_'+name
        o.Shape=shape;group.addObject(o)
        if App.GuiUp:
            o.ViewObject.ShapeColor=colour;o.ViewObject.DiffuseColor=[colour]
            o.ViewObject.Transparency=0;o.ViewObject.DisplayMode='Flat Lines'
            o.ViewObject.LineColor=colour
            o.ViewObject.LineWidth=1.0
        return o
    def ellipsoid(c,r):
        m=App.Matrix();m.A11=r[0];m.A22=r[1];m.A33=r[2]
        s=Part.makeSphere(1).transformGeometry(m);s.translate(V(*c));return s
    def link(a,b,r1,r2):
        a=V(*a);b=V(*b);d=b-a
        return Part.makeCone(r1,r2,d.Length,a,d)
    part('Body',ellipsoid((-15,0,99),(66,47,94)),brown)
    part('Chest',ellipsoid((28,0,118),(42,37,68)),(0.35,0.30,0.25))
    part('Head',ellipsoid((57,0,174),(43,32,37)),brown)
    part('Muzzle',ellipsoid((98,0,169),(39,21,19)),(0.42,0.35,0.30))
    part('Nose',ellipsoid((133,0,174),(7,10,6)),skin)
    for side in (-1,1):
        label='Left' if side>0 else 'Right'
        part(label+'_Haunch',ellipsoid((-35,side*35,57),(43,29,49)),brown)
        part(label+'_Hind_Paw',ellipsoid((-3,side*46,7),(33,13,7)),skin)
        part(label+'_Foreleg',link((28,side*29,101),(66,side*25,13),12,6),brown)
        part(label+'_Fore_Paw',ellipsoid((77,side*25,7),(21,10,7)),skin)
        for x,y,count in [(89,side*25,4),(20,side*46,5)]:
            toes=[];claws=[]
            for i in range(count):
                yy=y+(i-(count-1)/2)*4
                toes.append(ellipsoid((x,yy,4),(10,2.1,3)))
                claws.append(link((x+7,yy,4),(x+12,yy,2),1.1,0.15))
            limb='_Fore' if x==89 else '_Hind'
            part(label+limb+'_Toes',Part.makeCompound(toes),skin)
            part(label+limb+'_Claws',Part.makeCompound(claws),(0.73,0.68,0.55))
        part(label+'_Ear',ellipsoid((36,side*29,208),(18,9,25)),brown)
        part(label+'_Inner_Ear',ellipsoid((40,side*35,209),(13,4,19)),skin)
        part(label+'_Eye',ellipsoid((82,side*25,187),(6,5,6)),(0.035,0.025,0.02))
        part(label+'_Eye_Highlight',ellipsoid((85,side*28,190),(1.4,1.2,1.4)),(0.95,0.95,0.9))
    # Smooth, curved tail, with diminishing circular sections and small skin rings.
    curve=Part.BSplineCurve()
    curve.interpolate([V(-62,0,31),V(-100,7,13),V(-146,29,6),V(-192,57,5),V(-239,55,4),V(-264,29,4)])
    sections=[];rings=[]
    for i in range(33):
        u=curve.FirstParameter+(curve.LastParameter-curve.FirstParameter)*i/32
        p=curve.value(u);t=curve.tangent(u)[0];radius=5.6*(1-i/34)+0.25
        sections.append(Part.Wire([Part.makeCircle(radius,p,t)]))
        if 1<i<31:rings.append(Part.makeTorus(radius,0.13,p,t))
    part('Tail',Part.makeLoft(sections,True,False),skin)
    part('Tail_Rings',Part.makeCompound(rings),(0.43,0.29,0.27))
    whiskers=[]
    for side in (-1,1):
        for i in range(6):
            a=(113,side*14,170+i*1.2)
            b=(116-i*4,side*(41+i*2),171+(i-2)*4)
            c=(105-i*6,side*(64+i*3),170+(i-2)*7)
            whiskers.extend([link(a,b,0.22,0.15),link(b,c,0.15,0.04)])
    part('Whiskers',Part.makeCompound(whiskers),(0.66,0.63,0.58))
    fur=[]
    for i in range(160):
        theta=i*2.399963229728653;z=-0.15+1.1*((i%37)/36)
        radial=math.sqrt(max(0,1-z*z))
        p=V(-15+66*radial*math.cos(theta),47*radial*math.sin(theta),99+94*z)
        normal=V((p.x+15)/66**2,p.y/47**2,(p.z-99)/94**2);normal.normalize()
        fur.append(Part.makeCone(0.32,0.04,2.5+(i%4),p,normal))
    part('Fur_Detail',Part.makeCompound(fur),(0.30,0.26,0.22))
    return group


def prepare_camera_motion(doc):
    import FreeCADGui as Gui
    import math
    node=Gui.getDocument(doc.Name).activeView().getCameraNode()
    start_pos=V(*node.position.getValue().getValue())
    start_rot=App.Rotation(*node.orientation.getValue().getValue())
    start_angle=float(node.heightAngle.getValue())
    start_focal=float(node.focalDistance.getValue())
    # Perspective fit to the uploaded reference; exact framing depends on viewport aspect.
    end_pos=V(-9577.23776321,-4305.45248248,1572.59868617)
    target=V(0,-82.14273686,-332.41384124)
    back=end_pos-target;back.normalize()
    right=V(0,0,1).cross(back);right.normalize();up=back.cross(right)
    end_rot=App.Rotation(right,up,back,'ZXY')
    end_angle=2*math.atan(567.5/2916.53088779)
    end_focal=(end_pos-target).Length
    def camera_pose(fraction):
        pos=start_pos*(1-fraction)+end_pos*fraction
        rot=App.Rotation.slerp(start_rot,end_rot,fraction)
        node.position.setValue(tuple(pos))
        node.orientation.setValue(*rot.Q)
        # Increase the visible span smoothly to 120% of the previous final view.
        base_angle=start_angle+(end_angle-start_angle)*fraction
        node.heightAngle=2*math.atan(math.tan(base_angle/2)*(1+0.20*fraction))
        node.focalDistance=start_focal+(end_focal-start_focal)*fraction
    return camera_pose


def prepare_door_motion(doc):
    """Capture closed placements and rotate each leaf about its own hinge pin."""
    root = doc.getObject('_01_doors_french_doors')
    leaves = [[], []]
    for obj in root.Group:
        number = int(obj.Label[:3])
        if number < 3 or 'hinge_fixed_wing' in obj.Label:
            continue
        side = 0 if number < 26 else 1
        leaves[side].append((obj.Name, App.Placement(obj.Placement)))
    pivots = [V(-(FRENCH_DOOR_WIDTH/2-50),-26,0),
              V(FRENCH_DOOR_WIDTH/2-50,-26,0)]
    def pose(angle):
        for side, parts in enumerate(leaves):
            rotation = App.Rotation(V(0,0,1), (-1 if side==0 else 1)*angle)
            swing = App.Placement(V(0,0,0), rotation, pivots[side])
            for name, closed in parts:
                doc.getObject(name).Placement = swing.multiply(closed)
        doc.recompute()
    return pose


def prepare_rat_wave(doc):
    """One wave by the rat's anatomical right forepaw (local negative Y)."""
    names=['Rat_Right_Foreleg','Rat_Right_Fore_Paw',
           'Rat_Right_Fore_Toes','Rat_Right_Fore_Claws']
    if not SHOW_RAT or any(doc.getObject(name) is None for name in names):
        return None
    rest=[(name,App.Placement(doc.getObject(name).Placement)) for name in names]
    shoulder=V(28,-29,101)
    def smooth(t):
        return t*t*(3-2*t)
    def pose(fraction):
        import math
        t=min(1.0,max(0.0,fraction))
        if t <= 0 or t >= 1:
            for name,placement in rest:
                doc.getObject(name).Placement=placement
        else:
            if t < 0.3:
                lift=smooth(t/0.3);wave=0.0
            elif t < 0.7:
                lift=1.0;u=(t-0.3)/0.4
                # One side-to-side cycle, with zero velocity at both ends.
                wave=14*math.sin(2*math.pi*smooth(u))
            else:
                lift=smooth((1-t)/0.3);wave=0.0
            rotation=App.Rotation(V(1,0,0),30*lift+wave).multiply(
                App.Rotation(V(0,1,0),-115*lift))
            swing=App.Placement(V(0,0,0),rotation,shoulder)
            for name,placement in rest:
                doc.getObject(name).Placement=swing.multiply(placement)
        doc.recompute()
    return pose


def animate_rat_wave(doc):
    if not App.GuiUp:
        return
    pose=prepare_rat_wave(doc)
    if pose is None:
        return
    import time
    from PySide import QtCore
    timers=getattr(App,'_factory_rat_wave_timers',None)
    if timers is None:
        timers=App._factory_rat_wave_timers={}
    name=doc.Name
    previous=timers.pop(name,None)
    if previous is not None:
        previous.stop();previous.deleteLater()
    timer=QtCore.QTimer();timer.setInterval(33);timers[name]=timer
    started=time.monotonic()
    def finish():
        timer.stop()
        if timers.get(name) is timer:timers.pop(name,None)
        timer.deleteLater()
    def step():
        if name not in App.listDocuments() or doc.getObject('Rat_Right_Fore_Paw') is None:
            finish();return
        fraction=min(1.0,(time.monotonic()-started)/4.5)
        pose(fraction)
        if fraction >= 1.0:finish()
    timer.timeout.connect(step);timer.start()


def animate_door_opening(doc):
    """Non-blocking, one-shot opening; retain the final position indefinitely."""
    if not ANIMATE_DOOR_OPENING or not App.GuiUp:
        return
    import time
    from PySide import QtCore
    # Store timers on App so FreeCAD macro namespace cleanup cannot stop playback.
    timers = getattr(App, '_factory_door_animation_timers', None)
    if timers is None:
        timers = App._factory_door_animation_timers = {}
    previous = timers.pop(doc.Name, None)
    if previous is not None:
        previous.stop()
        previous.deleteLater()
    pose = prepare_door_motion(doc)
    camera_pose = prepare_camera_motion(doc)
    timer = QtCore.QTimer()
    timer.setInterval(33)
    timers[doc.Name] = timer
    started = time.monotonic()
    doc_name = doc.Name
    def finish():
        timer.stop()
        if timers.get(doc_name) is timer:
            timers.pop(doc_name, None)
        timer.deleteLater()
    def step():
        if doc_name not in App.listDocuments():
            finish()
            return
        if doc.getObject('Part__Feature452') is None or doc.getObject('Part__Feature475') is None:
            finish()
            return
        elapsed = (time.monotonic()-started) / max(0.1, DOOR_OPENING_SECONDS)
        fraction = min(1.0, max(0.0, elapsed))
        eased = fraction*fraction*(3-2*fraction)
        pose(DOOR_MAX_OPENING_ANGLE * eased)
        camera_pose(eased)
        if fraction >= 1.0:
            finish()
            animate_rat_wave(doc)
    timer.timeout.connect(step)
    timer.start()


def install_animation_restart(doc):
    # Capture the initial state before either animation starts.
    doc_name=doc.Name
    initial={}
    for group_name in ('_01_doors_french_doors','FactoryRat'):
        group=doc.getObject(group_name)
        if group is not None:
            for obj in group.Group:
                initial[obj.Name]=App.Placement(obj.Placement)
    def restart_factory_animation():
        if doc_name not in App.listDocuments():
            App.Console.PrintWarning('The container document is closed. Run this macro again to rebuild it.\n')
            return
        if not ANIMATE_DOOR_OPENING:
            App.Console.PrintWarning('Set ANIMATE_DOOR_OPENING = True at the top of the macro and run it again.\n')
            return
        # Cancel both stages so a restart also works during either animation.
        for attribute in ('_factory_door_animation_timers','_factory_rat_wave_timers'):
            timers=getattr(App,attribute,{})
            timer=timers.pop(doc_name,None)
            if timer is not None:
                timer.stop();timer.deleteLater()
        for name,placement in initial.items():
            obj=doc.getObject(name)
            if obj is not None:obj.Placement=App.Placement(placement)
        doc.recompute()
        set_default_camera(doc)
        animate_door_opening(doc)
        App.Console.PrintMessage('Factory animation restarted: doors and camera, then the rat wave.\n')
    # FreeCAD retains this callable after the macro's execution context ends.
    App.restart_factory_animation=restart_factory_animation
    App.Console.PrintMessage(
        '\nRESTART THE WHOLE FACTORY ANIMATION\n'
        '1. Open View > Panels > Python console.\n'
        '2. Enter: FreeCAD.restart_factory_animation()\n'
        'This resets the doors, camera and paw, then replays the full sequence.\n'
        'You can restart while it is running or after it has finished.\n'
        'These instructions are in View > Panels > Report view.\n'
        'If the document has been closed, run this macro again first.\n\n')


def set_default_camera(doc):
    if not App.GuiUp:
        return
    import FreeCADGui as Gui
    App.setActiveDocument(doc.Name)
    view = Gui.activeDocument().activeView()
    view.setCameraType('Perspective')
    node = view.getCameraNode()
    node.orientation.setValue(*(0.5643930267460263, -0.23147538977919738, -0.3126584480998956, 0.7280963879314282))
    node.position.setValue((-6494.96313245234, -6980.958950575403, 2056.470835016767))
    node.heightAngle = 0.5180065384900984
    node.focalDistance = 9754.353195205127
    node.nearDistance = 100.0
    node.farDistance = 30000.0
def interior_wall_faces(obj):
    """Return indices of inward-facing wall-panel faces in container coordinates."""
    if not any(word in obj.Label for word in ('Corrugated_panel','Rear_wall_panel','Door_Panel')):
        return []
    parent=obj.getGlobalPlacement().multiply(obj.Placement.inverse())
    indices=[]
    for i,face in enumerate(obj.Shape.Faces):
        u0,u1,v0,v1=face.ParameterRange
        normal=parent.Rotation.multVec(face.normalAt((u0+u1)/2,(v0+v1)/2))
        centre=parent.multVec(face.CenterOfMass)
        inward_x=abs(centre.x)>1100 and normal.x*centre.x < -0.2*abs(centre.x)
        inward_y=abs(centre.y)>2800 and normal.y*centre.y < -0.2*abs(centre.y)
        if abs(normal.z)<0.5 and (inward_x or inward_y):indices.append(i)
    return indices


def set_exterior_mirror_culling(obj,enabled):
    # FreeCAD/Coin viewport approximation: render the coating only from its
    # outward-facing side. True reflected surroundings require Blender rendering.
    from pivy import coin
    root=obj.ViewObject.RootNode
    for i in range(root.getNumChildren()-1,-1,-1):
        child=root.getChild(i)
        if str(child.getName())=='ExteriorMirrorOneSided':root.removeChild(i)
    if enabled:
        hints=coin.SoShapeHints();hints.setName('ExteriorMirrorOneSided')
        hints.vertexOrdering=coin.SoShapeHints.COUNTERCLOCKWISE
        hints.shapeType=coin.SoShapeHints.SOLID
        hints.setOverride(True)
        root.insertChild(hints,0)


def apply_factory_appearance(doc):
    if not App.GuiUp:return
    grey=(0.5,0.5,0.5);blue=(0.06,0.24,0.55);black=(0.025,0.025,0.025)
    white=(0.92,0.92,0.90)
    # SIGN SPECIFICATION: individual 2 mm-thick STAINLESS STEEL cut letters.
    # Satin/brushed finish; Blender Metallic=1, Roughness=0.25, Anisotropy=0.35.
    # FreeCAD's specular material previews metal but does not ray-trace reflections.
    stainless=(0.65,0.67,0.69)
    doors=doc.getObject('_01_doors_french_doors')
    door_names={obj.Name for obj in doors.Group} if doors is not None else set()
    for obj in doc.Objects:
        if obj.TypeId!='Part::Feature':continue
        view=obj.ViewObject
        if obj.Name.startswith(('Roofing_Sheet_','Timber_Post_','Timber_Crossbeam_','Timber_End_Beam_','Timber_Batten_')):
            transparent=ALL_PARTS_50_PERCENT_TRANSPARENT
            roofing=obj.Name.startswith('Roofing_Sheet_')
            colour=grey if transparent else ((0.015,0.015,0.015) if roofing else (1.0,0.85,0.0))
            material=view.ShapeMaterial;material.DiffuseColor=colour
            material.Transparency=0.5 if transparent else 0
            material.Shininess=30 if roofing else 20
            view.ShapeMaterial=material;view.ShapeColor=colour
            view.DiffuseColor=[colour];view.Transparency=50 if transparent else 0
            view.LineColor=(0.15,0.15,0.15) if transparent else ((0.005,0.005,0.005) if roofing else (0.35,0.25,0.0))
            continue
        if obj.Name.startswith('Rat_'):
            view.Transparency=0;continue
        transparent=ALL_PARTS_50_PERCENT_TRANSPARENT
        mirror='Exterior_mirror_finish' in obj.Label
        glass='glass_panel' in obj.Label and obj.Name in door_names
        sign=obj.Name.startswith('SignLetter_')
        fixture=obj.Name.startswith('Strip_Light_')
        diffuser=fixture and obj.Name.endswith('_Diffuser')
        colour=grey if transparent else blue
        if not transparent:
            if obj.Name in door_names:
                structural=any(word in obj.Label for word in
                    ('Perimeter_','leaf_stile','leaf_rail','vertical_muntin'))
                colour=black if structural else grey
                if mirror:colour=(0.82,0.84,0.87)
                if glass:colour=(0.92,0.97,0.98)
            elif sign:colour=stainless
            elif fixture:colour=(0.96,0.94,0.88) if diffuser else (0.80,0.82,0.84)
        # Glass is the intentional exception to opaque material mode in version 09.
        opacity_transparency=50 if transparent else (85 if glass else 0)
        material=view.ShapeMaterial
        material.DiffuseColor=colour
        material.EmissiveColor=(0.8,0.72,0.60) if diffuser and not transparent else (0,0,0)
        polished=(mirror or sign or glass) and not transparent
        material.SpecularColor=(0.95,0.95,0.95) if polished else (0.2,0.2,0.2)
        material.Shininess=(100.0 if mirror or glass else 75.0) if polished else 20.0
        material.Transparency=opacity_transparency/100.0
        view.ShapeMaterial=material;view.ShapeColor=colour;view.DiffuseColor=[colour]
        view.LineColor=(0.15,0.15,0.15);view.Transparency=opacity_transparency
        if not transparent:
            white_faces=interior_wall_faces(obj)
            if white_faces:
                colours=[colour]*len(obj.Shape.Faces)
                for index in white_faces:colours[index]=white
                view.DiffuseColor=colours
                if 'InteriorWhiteFaces' not in obj.PropertiesList:
                    obj.addProperty('App::PropertyIntegerList','InteriorWhiteFaces','Rendering')
                obj.InteriorWhiteFaces=[i+1 for i in white_faces]
        if sign:
            if 'MaterialSpecification' not in obj.PropertiesList:
                obj.addProperty('App::PropertyString','MaterialSpecification','Rendering')
            obj.MaterialSpecification='2 mm stainless steel; satin brushed finish; Blender metallic 1, roughness 0.25'
        if mirror:set_exterior_mirror_culling(obj,not transparent)


def add_roof_strip_lights(doc):
    # Four 1000 mm transverse fixtures on flat inner roof lands, 1463 mm apart.
    # Mounting plate top Z=1256 touches the actual inner roof surface.
    # Blender: run blender_lights.py after importing named diffuser meshes.
    group=doc.addObject('App::Part','Interior_Strip_Lights')
    group.Label='Interior_Strip_Lights'
    for index,y in enumerate((-2194.5,-731.5,731.5,2194.5),1):
        prefix='Strip_Light_%02d_'%index
        fixture=doc.addObject('App::Part',prefix+'Assembly');fixture.Label=fixture.Name
        group.addObject(fixture)
        def part(suffix,shape):
            obj=doc.addObject('Part::Feature',prefix+suffix);obj.Label=obj.Name
            obj.Shape=shape;fixture.addObject(obj);return obj
        part('Mounting_Plate',Part.makeBox(1000,60,2,V(-500,y-30,1254)))
        housing=Part.makeBox(1000,60,24,V(-500,y-30,1230))
        housing=housing.cut(Part.makeBox(980,44,23,V(-490,y-22,1229)))
        part('Housing',housing)
        diffuser=part('Diffuser',Part.makeBox(980,44,2,V(-490,y-22,1228)))
        for typ,name,value in [
            ('App::PropertyString','BlenderLightType','AREA_RECTANGLE'),
            ('App::PropertyFloat','BlenderPowerWatts',20.0),
            ('App::PropertyFloat','ColourTemperatureKelvin',4000.0),
            ('App::PropertyString','BlenderSetupScript','blender_lights.py'),
            ('App::PropertyVector','EmissionDirection',V(0,0,-1))]:
            diffuser.addProperty(typ,name,'Rendering');setattr(diffuser,name,value)
        bolts=[]
        for x in (-460,460):
            for yy in (y-25,y+25):
                shaft=Part.makeCylinder(2,28,V(x,yy,1230))
                head=Part.makeCylinder(3.5,2,V(x,yy,1228))
                # Visible screwdriver slot beneath the flush mounting plate.
                head=head.cut(Part.makeBox(5,1,0.7,V(x-2.5,yy-.5,1228)))
                bolts.append(shaft.fuse(head))
        part('Mounting_Bolts',Part.makeCompound(bolts))
    return group


def install_strip_light_preview(doc):
    if not App.GuiUp:return
    import FreeCADGui as Gui
    from pivy import coin
    root=Gui.getDocument(doc.Name).activeView().getSceneGraph()
    for i in range(root.getNumChildren()-1,-1,-1):
        if str(root.getChild(i).getName())=='FactoryInteriorLights':root.removeChild(i)
    # Group (not Separator) lets lighting state reach the following model nodes.
    lights=coin.SoGroup();lights.setName('FactoryInteriorLights')
    for y in (-2194.5,-731.5,731.5,2194.5):
        light=coin.SoSpotLight();light.location=(0,y,1227)
        light.direction=(0,0,-1);light.color=(1.0,0.9,0.75)
        light.intensity=0.6;light.cutOffAngle=1.35;light.dropOffRate=0.15
        lights.addChild(light)
    root.insertChild(lights,0)


